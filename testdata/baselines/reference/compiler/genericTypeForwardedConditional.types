=== genericTypeForwardedConditional.ts ===
// repro from #4581

type IsTuple<TMaybeTuple> = TMaybeTuple extends any[] ? TMaybeTuple : never;
>IsTuple : IsTuple<TMaybeTuple>

type DeepKeys<TObj, TDone = false> = TDone extends true
>DeepKeys : DeepKeys<TObj, TDone>
>false : false
>true : true

    ? never
    : TObj extends any[] & IsTuple<TObj>
      ? never
      : TObj extends object
        ? keyof TObj | DeepKeysPrefix<TObj, keyof TObj>
        : never;

type DeepKeysPrefix<TParent, TPrefix> = TPrefix extends keyof TParent
>DeepKeysPrefix : DeepKeysPrefix<TParent, TPrefix>

    ? DeepKeys<TParent[TPrefix], true>
>true : true

    : never;

declare function DataTable<TArg>(props: { accessorKey: DeepKeys<TArg> }): void;
>DataTable : <TArg>(props: { accessorKey: DeepKeys<TArg>; }) => void
>props : { accessorKey: DeepKeys<TArg>; }
>accessorKey : TArg extends any[] & IsTuple<TArg> ? never : TArg extends object ? keyof TArg | DeepKeysPrefix<TArg, keyof TArg> : never

export const Table = <TRow extends object>(accessorKey: DeepKeys<TRow>) =>
>Table : <TRow extends object>(accessorKey: DeepKeys<TRow>) => void
><TRow extends object>(accessorKey: DeepKeys<TRow>) =>    DataTable({ accessorKey }) : <TRow extends object>(accessorKey: DeepKeys<TRow>) => void
>accessorKey : TRow extends any[] & IsTuple<TRow> ? never : TRow extends object ? keyof TRow | DeepKeysPrefix<TRow, keyof TRow> : never

    DataTable({ accessorKey });
>DataTable({ accessorKey }) : void
>DataTable : <TArg>(props: { accessorKey: DeepKeys<TArg>; }) => void
>{ accessorKey } : { accessorKey: TRow extends any[] & IsTuple<TRow> ? never : TRow extends object ? keyof TRow | DeepKeysPrefix<TRow, keyof TRow> : never; }
>accessorKey : TRow extends any[] & IsTuple<TRow> ? never : TRow extends object ? keyof TRow | DeepKeysPrefix<TRow, keyof TRow> : never

